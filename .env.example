# AirPrompt development configuration.
#
# Copy to `.env.local` and edit. `.env.local` is git-ignored.
#
# NOTHING HERE IS A SECRET. API keys are never read from this file — they go to
# the operating system's credential store through Settings → AI Enhancement.
# Putting a real key in an environment file is exactly the mistake this file is
# designed to prevent.

# ------------------------------------------------------------------ frontend

# Label a development build can show. The name the code itself uses comes from
# `src/identity.ts`; this variable exists only so a local build can be labelled
# differently without editing code.
VITE_APP_NAME=AirPrompt

# Prefix for Rust log output when running in development, e.g.
# "airprompt=debug". The in-app log level in Settings → Diagnostics takes
# precedence at runtime.
RUST_LOG=airprompt=info,airprompt_core=info,airprompt_platform=info

# --------------------------------------------------------------- local AI

# Default endpoint pre-filled in Settings → AI Enhancement for a llama.cpp
# server. Ollama (11434) and LM Studio (1234) have their own defaults built in.
LOCAL_AI_ENDPOINT=http://127.0.0.1:8080/v1

# Default model name suggested for a local provider. This is a label only; the
# provider must actually serve a model by that name.
LOCAL_AI_MODEL=

# ------------------------------------------------------------- speech engine

# Explicit path to the whisper.cpp CLI, for development.
#
# AirPrompt otherwise searches the app resources directory and PATH, in that
# order. Leave unset to use the normal discovery.
#
# macOS example:
#   AIRPROMPT_WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# Windows example (note the doubled backslashes, or use forward slashes):
#   AIRPROMPT_WHISPER_BIN=C:/tools/whisper.cpp/build/bin/Release/whisper-cli.exe
#
# Migration: an earlier build of this product read `JARVIS_WHISPER_BIN`, and that
# name is still honoured as a fallback (see `LEGACY_ENV_WHISPER_BIN` in
# `src-tauri/core/src/identity.rs`), so an existing shell configuration keeps
# working. New configuration belongs under the AIRPROMPT_ name.
AIRPROMPT_WHISPER_BIN=

# ---------------------------------------------------------------- optional

# Where downloaded speech models are stored. Leave unset to use the per-user
# application data directory, which is what a normal install should do.
#
# macOS:   ~/Library/Application Support/com.airprompt.app/models
# Windows: %APPDATA%\com.airprompt.app\models
#
# Migration: `JARVIS_MODELS_DIR` is still read as a fallback
# (`LEGACY_ENV_MODELS_DIR`).
AIRPROMPT_MODELS_DIR=

# ------------------------------------------------------------ never put here

# Do NOT add any of the following to this file:
#
#   OPENAI_API_KEY / GROQ_API_KEY / any provider secret
#   APPLE_SIGNING_IDENTITY / APPLE_PASSWORD / APPLE_TEAM_ID
#   TAURI_SIGNING_PRIVATE_KEY / TAURI_SIGNING_PRIVATE_KEY_PASSWORD
#   Any code-signing certificate or password
#
# Secrets belong in the OS credential store (for runtime keys) or in your shell
# or CI secret store (for build-time signing). See docs/SECURITY.md and the
# BUILD_*.md files for where each one goes.
